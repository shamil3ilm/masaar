# ==============================================================================
# Environment configuration template
# ==============================================================================
# For a partner deployment
#
# Instructions:
# 1. Copy this file to .env in the same directory as docker-compose.yml
# 2. Replace all placeholder values (marked with <...>)
# 3. Generate the secrets (docs/operations/DEPLOYMENT.md shows how)
# 4. Run: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# With APP_ENV=production the application refuses to start while a setting
# it needs is missing or still a placeholder, and names it.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
APP_NAME=Masaar
APP_ENV=production
APP_KEY=<GENERATE_WITH_php_artisan_key:generate>
APP_DEBUG=false
APP_URL=https://<YOUR_DOMAIN>

# The image to run, when pulled from a registry rather than built here
# (docs/operations/DOCKER-REGISTRY.md). Pin a version in production.
# IMAGE_NAME=platform
IMAGE_TAG=latest
APP_PORT=8000

# ------------------------------------------------------------------------------
# Secrets - generate each once, store it outside the server, never reuse
# ------------------------------------------------------------------------------
# Signs API login tokens. Without it no token can be issued.
#   docker compose run --rm app php artisan jwt:secret --show
JWT_SECRET=<GENERATE_WITH_php_artisan_jwt:secret_--show>
# Mixed into every stored API key hash. Set it before the first key is issued:
# changing it later invalidates every key already issued.
#   openssl rand -base64 32
API_KEY_PEPPER=<GENERATE_WITH_openssl_rand_-base64_32>
# Encrypts each device's ZATCA private key and CSID. Required: production
# refuses to serve without it. During a rotation the old key goes in
# PREVIOUS_KEYS, then php artisan platform:rotate-credential-key, then
# PREVIOUS_KEYS is cleared (docs/operations/KEY-ROTATION.md).
ZATCA_CREDENTIAL_KEY=<GENERATE_WITH_php_artisan_key:generate_--show>
ZATCA_CREDENTIAL_PREVIOUS_KEYS=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=platform
DB_USERNAME=platform
DB_PASSWORD=<SECURE_DATABASE_PASSWORD>
DB_ROOT_PASSWORD=<SECURE_ROOT_PASSWORD>
# Migrations create the immutability triggers. With binary logging on, the
# MySQL server needs log_bin_trust_function_creators=1 and the migrating user
# the TRIGGER privilege. To keep TRIGGER, ALTER and DROP from the application
# user, give the migrate step its own account (docs/operations/DEPLOYMENT.md).
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# External port mapping (optional - for direct DB access)
DB_EXTERNAL_PORT=3306

# ------------------------------------------------------------------------------
# Cache, Session & Queue
# ------------------------------------------------------------------------------
# The database by default: no extra service to run.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Redis (optional)
# ------------------------------------------------------------------------------
# To move cache, sessions and queues to Redis: uncomment these, set the three
# drivers above to redis, and start the stack with the redis profile.
# COMPOSE_PROFILES=redis
# REDIS_HOST=redis
# REDIS_PASSWORD=<SECURE_REDIS_PASSWORD>
# REDIS_PORT=6379
# REDIS_EXTERNAL_PORT=6379

# ------------------------------------------------------------------------------
# ZATCA Integration
# ------------------------------------------------------------------------------
# The default for organizations with no ZATCA environment of their own: a
# platform admin sets each organization's in the console. sandbox, simulation
# or production; production refuses sandbox. The sandbox files only for
# ZATCA's test VAT number, which platform:rehearse uses.
ZATCA_ENVIRONMENT=production
# Saudi Arabia on by default. The admin console's Countries page can switch it
# off or on later, and its switch wins over this.
ZATCA_ENABLED=true

# ZATCA's gateway and portal addresses. Leave empty to use ZATCA's published
# ones; set them only if the authority moves an endpoint.
ZATCA_SANDBOX_URL=
ZATCA_SIMULATION_URL=
ZATCA_PRODUCTION_URL=
ZATCA_PORTAL_URL=
# PEM bundle of ZATCA's CA certificates (issuing CA up to the root). Stamped
# PDFs carry this chain, as the Security Features standard asks, and it
# verifies revocation lists served over http. Required while Saudi Arabia is
# on: /api/health/ready fails without a readable file.
ZATCA_CA_CHAIN_PATH=
# The CA's revocation list URLs (comma-separated), for certificates that name
# no CRL distribution point. Checked before every stamp. /api/health/ready
# fails while an active certificate names none and this is empty.
ZATCA_CRL_URLS=
# Full path to the OpenSSL binary the onboarding commands run. Empty: the one
# on the PATH.
OPENSSL_BIN=

# No API username or password: each device files with the token and secret
# issued when it was onboarded, kept in the credential store.

# Queue connection for submission jobs; empty uses QUEUE_CONNECTION.
# ZATCA_QUEUE_CONNECTION=

# ------------------------------------------------------------------------------
# Peppol e-invoicing (UAE)
# ------------------------------------------------------------------------------
# Off for a Saudi-only deployment: no organization can be registered in the
# UAE. The default only - the admin console's Countries page can switch it on
# or off later, and its switch wins. With a base URL set, production requires
# the other three, whether or not the UAE is on yet.
PEPPOL_AE_ENABLED=false
# PEPPOL_ASP_BASE_URL=<ASP_API_URL>
# PEPPOL_ASP_CLIENT_ID=<ASP_CLIENT_ID>
# PEPPOL_ASP_CLIENT_SECRET=<ASP_CLIENT_SECRET>
# PEPPOL_ASP_WEBHOOK_SECRET=<ASP_WEBHOOK_SECRET>

# ------------------------------------------------------------------------------
# Mail - certificate expiry notices and password resets
# ------------------------------------------------------------------------------
# Production refuses the log and array mailers and a from address at
# example.com: sign-up, invitations and notices would go nowhere.
MAIL_MAILER=smtp
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USERNAME>
MAIL_PASSWORD=<SMTP_PASSWORD>
# MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=<NOREPLY_ADDRESS>
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Platform licence
# ------------------------------------------------------------------------------
# A partner's installation: the key and secret it was issued. While
# licensing is enabled (the default) every API request needs a valid key.
PLATFORM_LICENSE_KEY=<ISSUED_LICENCE_KEY>
# Required while licensing is enforced: production refuses to boot without it.
PLATFORM_LICENSE_SECRET=<ISSUED_LICENCE_SECRET>
# A deployment its operator runs itself, under no partner licence:
# PLATFORM_LICENSE_ENABLED=false

# ------------------------------------------------------------------------------
# Network
# ------------------------------------------------------------------------------
# The reverse proxy whose X-Forwarded-* headers are believed. Set by
# docker-compose.prod.yml for Traefik; only for a different proxy.
# TRUSTED_PROXIES=
# Browser origins allowed to call the API, comma-separated. Empty allows none.
# CORS_ALLOWED_ORIGINS=https://<YOUR_APP_DOMAIN>
# Restrict tenants' webhook destinations to these hosts (comma-separated; a
# leading dot allows a zone's subdomains). Usually empty: then any https host
# that resolves only to public addresses.
# WEBHOOK_ALLOWED_HOSTS=
# The same, for the certificate revocation endpoints read from inside the
# certificates being validated.
# REVOCATION_ALLOWED_HOSTS=
# Cookie domain, only when the console is served under a parent domain.
# SESSION_DOMAIN=

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=info
# Critical events (a submission that will not be filed, an expired
# certificate, a failed backup) also go to this chat webhook when set.
LOG_SLACK_WEBHOOK_URL=
# LOG_DEPRECATIONS_CHANNEL=null

# ------------------------------------------------------------------------------
# Monitoring - /api/metrics is closed unless one of these is set
# ------------------------------------------------------------------------------
# METRICS_TOKEN=<GENERATE_WITH_openssl_rand_-hex_32>
# METRICS_ALLOWED_IPS=<SCRAPER_IP>

# ------------------------------------------------------------------------------
# Backups - see docs/operations/BACKUP-AND-RESTORE.md
# ------------------------------------------------------------------------------
# Required: without it the nightly backup is refused rather than uploaded
# unencrypted. Keep it, APP_KEY and ZATCA_CREDENTIAL_KEY outside the server.
BACKUP_ARCHIVE_PASSWORD=<GENERATE_WITH_openssl_rand_-base64_32>
BACKUP_STORAGE_ENDPOINT=<S3_COMPATIBLE_ENDPOINT>
BACKUP_STORAGE_REGION=<REGION>
BACKUP_STORAGE_BUCKET=<BUCKET>
BACKUP_STORAGE_KEY=<ACCESS_KEY>
BACKUP_STORAGE_SECRET=<SECRET_KEY>
# skip-ssl for the compose MySQL's self-signed certificate (the default in
# docker-compose.yml); empty for a managed database with a trusted one.
# DB_DUMP_SSL_FLAG=skip-ssl

# The stock object-storage disk, unused by the platform itself.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET=

# ------------------------------------------------------------------------------
# Database Migration
# ------------------------------------------------------------------------------
# true: the container entrypoint runs migrations at every start. Set it for
# the first start, then back to false and migrate by hand on upgrades.
# Take a backup before any migration.
AUTO_MIGRATE=false

# ------------------------------------------------------------------------------
# SSL/TLS (for Traefik reverse proxy)
# ------------------------------------------------------------------------------
# The host name Traefik serves and requests a certificate for, and the address
# the certificate authority writes to.
APP_DOMAIN=<YOUR_DOMAIN>
SSL_EMAIL=<YOUR_EMAIL_FOR_LETSENCRYPT>

# ------------------------------------------------------------------------------
# SECURITY NOTES
# ------------------------------------------------------------------------------
# 1. Never commit this file to version control
# 2. Use strong, unique passwords for all credentials
# 3. Rotate passwords periodically
# 4. Restrict database access to container network only
# 5. Enable SSL/TLS for all external connections
# 6. Keep this file with restricted permissions (chmod 600)
# ==============================================================================

# Sign-up
# Businesses register themselves at /register, verify their email address,
# and wait for a platform admin to approve them before they can connect to
# ZATCA or issue. Off: the platform creates every organization itself.
SIGNUP_ENABLED=true
# The terms a business accepts, and their version - stored with each
# acceptance, so a change of terms is a new version.
# Empty: the /terms page this deployment publishes.
SIGNUP_TERMS_URL=
SIGNUP_TERMS_VERSION=1

# Where a new support ticket is announced by email. Empty: only the admin
# console's Support queue shows them.
SUPPORT_NOTIFY_ADDRESS=
# Megabytes of ticket attachments one company may add in a day.
SUPPORT_DAILY_UPLOAD_MB=50

# Billing
# The organization the platform's own invoices are issued from - the
# operator's company, approved and connected to ZATCA like any other. Empty:
# recorded payments renew plans and no invoice is issued for them.
BILLING_ORGANIZATION_ID=
# The card gateway: empty until a card provider is contracted. Never
# simulator here: production refuses to boot with it.
PAYMENT_GATEWAY=

# Who operates this deployment, as the public pages, the privacy notice and
# the terms name them. Fill these before the first customer signs up.
COMPANY_LEGAL_NAME=
COMPANY_CR_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
# Raise when the privacy notice changes.
PRIVACY_VERSION=1

# An organization needs an active licence - its plan, assigned when a platform
# admin approves it - before it can connect to ZATCA and issue.
LICENSING_FILING_REQUIRES_LICENCE=true
