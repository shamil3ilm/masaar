{
    "name": "masaar/masaar-php",
    "description": "ZATCA-compliant e-invoicing API client for PHP 7.4+",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Masaar",
            "email": "support@masaar.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Masaar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Masaar\\Tests\\": "tests/"
        }
    },
    "keywords": [
        "zatca",
        "e-invoicing",
        "saudi-arabia",
        "ksa",
        "tax",
        "invoice",
        "compliance",
        "laravel"
    ],
    "homepage": "https://masaar.com",
    "support": {
        "issues": "https://github.com/masaar/masaar-php/issues"
    }
}
