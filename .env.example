APP_NAME=Masaar
# Safe-by-default: a deployment seeded from this file starts in production mode
# with debug off. For local development set APP_ENV=local and APP_DEBUG=true.
# The application refuses to boot with APP_ENV=production and APP_DEBUG=true,
# because debug mode returns internal error detail through the API.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT Authentication
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# CORS Configuration
# Comma-separated list of allowed origins (leave empty to block all cross-origin requests)
CORS_ALLOWED_ORIGINS=

# Prometheus Metrics Access
# /api/metrics exposes version and business telemetry. Admit a scraper by its
# source IP or by a bearer token. With both empty the endpoint is unreachable
# in production and open outside it.
# Behind a reverse proxy, prefer the token: TrustProxies is not configured, so
# the observed source IP is the proxy's. See config/metrics.php.
METRICS_ALLOWED_IPS=
METRICS_TOKEN=

# Outbound Fetch Controls
# Hosts the server may contact when the address came from data it did not
# choose - certificate revocation endpoints are read from inside the
# certificate being validated. Comma-separated; a leading dot allows that
# zone's subdomains. Leave empty and the fallback applies: https only, and
# the host must not resolve to a private, loopback or link-local address.
REVOCATION_ALLOWED_HOSTS=
OUTBOUND_FETCH_TIMEOUT=10
OUTBOUND_FETCH_MAX_BYTES=5242880

# API Key Hashing
# Mixed into API key hashes so a leaked api_keys table cannot be attacked
# offline. Setting or changing this invalidates every key issued before it.
API_KEY_PEPPER=

# Rate Limits (per tenant, per minute, per cost band)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_SUBMISSION=30
RATE_LIMIT_ONBOARDING=5
RATE_LIMIT_READ=120
RATE_LIMIT_ANONYMOUS=20

# Signing Credential Storage
# Where each taxpayer's CSID credentials are kept. The default is the
# container's own filesystem, which confines the platform to one replica:
# a tenant onboarded on one instance cannot sign on another. Point this at a
# shared, private disk before scaling out.
ZATCA_CREDENTIAL_DISK=local

# The secret those credentials are encrypted under. Empty falls back to
# APP_KEY, which also protects sessions and cookies and sits in every
# container - a wide blast radius for signing keys. Set this, keep the old
# value in PREVIOUS_KEYS, run masaar:rotate-credential-key, then clear it.
ZATCA_CREDENTIAL_KEY=
ZATCA_CREDENTIAL_PREVIOUS_KEYS=

# ZATCA E-Invoicing Configuration
ZATCA_ENVIRONMENT=sandbox
ZATCA_USERNAME=
ZATCA_PASSWORD=
ZATCA_CERTIFICATE_PATH=
ZATCA_PRIVATE_KEY_PATH=
ZATCA_CERT_WARNING_DAYS=30
ZATCA_CERT_CRITICAL_DAYS=7
ZATCA_TIMEOUT=30
ZATCA_CONNECT_TIMEOUT=10
ZATCA_RETRY_ATTEMPTS=3
ZATCA_RETRY_DELAY=1000
ZATCA_SSL_VERIFY=true

# ZATCA Rate Limits
ZATCA_RATE_LIMIT_PER_MINUTE=60
ZATCA_RATE_LIMIT_PER_DAY=10000
ZATCA_MAX_CONCURRENT=10

# ZATCA Circuit Breaker
ZATCA_CIRCUIT_BREAKER_ENABLED=true
ZATCA_CB_THRESHOLD=5
ZATCA_CB_TIMEOUT=60
ZATCA_CB_SAMPLE_SIZE=10

# ZATCA Offline Mode
ZATCA_OFFLINE_ENABLED=true
ZATCA_OFFLINE_QUEUE_MAX=10000
ZATCA_OFFLINE_RETRY_INTERVAL=300
ZATCA_OFFLINE_MAX_ATTEMPTS=3
ZATCA_CONNECTIVITY_CHECK_INTERVAL=30
ZATCA_CONNECTIVITY_TIMEOUT=10
ZATCA_CONNECTIVITY_FAILURE_THRESHOLD=3
ZATCA_CONNECTIVITY_CIRCUIT_DURATION=60
ZATCA_LOCAL_SIGNING_ENABLED=true
ZATCA_LOCAL_QR_ENABLED=true
ZATCA_LOCAL_STORAGE_FALLBACK=true
# ZATCA_FALLBACK_PATH=
ZATCA_AUTO_RECOVERY_ENABLED=true
ZATCA_AUTO_RECOVERY_BATCH=50
ZATCA_AUTO_RECOVERY_DELAY=5
ZATCA_AUTO_RECOVERY_BACKGROUND=true
ZATCA_POS_MODE_ENABLED=false
ZATCA_POS_IMMEDIATE_QR=true
ZATCA_POS_MAX_OFFLINE_VALUE=50000
ZATCA_POS_QUEUE_WARNING=100

# ZATCA Timestamp Authority (optional, for XAdES-T)
ZATCA_TSA_ENABLED=false
# ZATCA_TSA_URL=
# ZATCA_TSA_USERNAME=
# ZATCA_TSA_PASSWORD=
ZATCA_TSA_TIMEOUT=30

# ZATCA Defaults
ZATCA_DEFAULT_PAYMENT_MEANS=10
ZATCA_DEFAULT_CURRENCY=SAR
ZATCA_DEFAULT_COUNTRY=SA

# ZATCA Feature Flags
ZATCA_FEATURE_ASYNC=true
ZATCA_FEATURE_OFFLINE=true
ZATCA_FEATURE_CIRCUIT_BREAKER=true
ZATCA_FEATURE_TSA=false
ZATCA_FEATURE_CRL_CHECK=true
ZATCA_FEATURE_ARABIC_NORM=true

# ZATCA Queue
ZATCA_QUEUE_CONNECTION=redis
ZATCA_QUEUE_NAME=zatca-submissions
ZATCA_QUEUE_TRIES=3
ZATCA_QUEUE_TIMEOUT=120
ZATCA_QUEUE_SUBMISSIONS=zatca-submissions
ZATCA_QUEUE_WEBHOOKS=webhooks
ZATCA_QUEUE_MAX_ATTEMPTS=3
ZATCA_QUEUE_RETRY_BACKOFF=60
ZATCA_QUEUE_JOB_TIMEOUT=120

# ZATCA Logging
ZATCA_LOG_CHANNEL=stack
ZATCA_LOG_LEVEL=info
ZATCA_LOG_SANITIZE=true

# ZATCA Timestamp Validation
ZATCA_MAX_DRIFT_SECONDS=30
ZATCA_WARN_ERP_DRIFT=true
ZATCA_ENFORCE_TIMESTAMP_VALIDATION=true

# ZATCA Webhooks
ZATCA_WEBHOOKS_ENABLED=true
ZATCA_WEBHOOK_MAX_AGE=300
ZATCA_WEBHOOK_RETRY_ATTEMPTS=3
ZATCA_WEBHOOK_RETRY_DELAY=5
ZATCA_WEBHOOK_TIMEOUT=10

# ZATCA Idempotency
ZATCA_IDEMPOTENCY_HOURS=24

# ZATCA Thresholds
ZATCA_LARGE_INVOICE_THRESHOLD=1000000

# ZATCA Variance Tracking
ZATCA_VARIANCE_TRACKING_ENABLED=true
ZATCA_VARIANCE_ASYNC=true
ZATCA_VARIANCE_CACHE_TTL=24
ZATCA_VARIANCE_RETRY_MAX=3

# ZATCA Index Health
ZATCA_INDEX_HEALTH_ENABLED=true
ZATCA_INDEX_CHECK_INTERVAL=15
ZATCA_P95_WARNING_MS=100
ZATCA_P99_CRITICAL_MS=500
ZATCA_SEQ_SCAN_WARNING=1000
ZATCA_ALERT_ON_CRITICAL=true

# ZATCA Partitioning
ZATCA_PARTITIONING_ENABLED=false
ZATCA_PARTITION_THRESHOLD=10000000
ZATCA_PARTITION_MONTHS_AHEAD=2
ZATCA_ARCHIVE_THRESHOLD_MONTHS=84

# ZATCA Queue Health
ZATCA_QUEUE_STUCK_THRESHOLD=30
ZATCA_QUEUE_MAX_RETRIES=5
ZATCA_QUEUE_GROWTH_THRESHOLD=100
ZATCA_QUEUE_MIN_RATE=10
ZATCA_QUEUE_ALERT_COOLDOWN=30

# ZATCA Cluster Circuit Breaker
ZATCA_CCB_FAILURE_THRESHOLD=5
ZATCA_CCB_SUCCESS_THRESHOLD=3
ZATCA_CCB_TIMEOUT=60
ZATCA_CCB_HALF_OPEN_REQUESTS=3
ZATCA_CCB_NODE_STALE=300

# ZATCA Back Pressure
ZATCA_BP_TOKENS_PER_SEC=10
ZATCA_BP_BUCKET_SIZE=100
ZATCA_BP_MIN_TOKENS=1
ZATCA_BP_BURST_ALLOWANCE=50

# ZATCA Kill Switch
ZATCA_KS_MAX_DURATION=14400
ZATCA_KS_ALERT_THRESHOLD=1800
ZATCA_KS_CACHE_TTL=3600

# ZATCA Hash Chain
ZATCA_HASH_CHAIN_LOCK_TIMEOUT=30
ZATCA_HASH_CHAIN_MONITORING=true
ZATCA_HASH_CHAIN_P95_WARNING=50
ZATCA_HASH_CHAIN_P99_CRITICAL=200
ZATCA_HASH_CHAIN_SAMPLE_INTERVAL=5
ZATCA_HASH_CHAIN_ALERT=true

# ZATCA VAT Period
ZATCA_VAT_PERIOD_TYPE=monthly
ZATCA_VAT_FILING_DEADLINE_DAY=28
ZATCA_FUZZY_MATCH_HOURS=24
ZATCA_TRACK_CROSS_PERIOD=true

# ZATCA Duplicate Detection
ZATCA_DEDUP_CACHE_TTL=60
ZATCA_FUZZY_MATCHING=true
ZATCA_FUZZY_AMOUNT_TOLERANCE=1.0
ZATCA_SYNC_CONFLICT_DETECTION=true
ZATCA_SYNC_LOOKBACK_MINUTES=60

# ZATCA Strict Exemption Codes
ZATCA_STRICT_EXEMPTION_CODES=false

# ZATCA Infrastructure - Clock
ZATCA_MAX_CLOCK_DRIFT_WARNING=1
ZATCA_MAX_CLOCK_DRIFT_CRITICAL=5
ZATCA_ENFORCE_UTC=true
ZATCA_NTP_SERVER=pool.ntp.org
ZATCA_MONITOR_CLOCK_DRIFT=true
ZATCA_MAX_CLOCK_DRIFT_MS=1000
ZATCA_CLOCK_MONITORING=true

# ZATCA Infrastructure - Database
ZATCA_DB_ISOLATION="READ COMMITTED"
ZATCA_VERIFY_DB_ISOLATION=true
ZATCA_BLOCK_INVALID_ISOLATION=true

# ZATCA Policies
ZATCA_TIME_PRECEDENCE=tsa_then_system
ZATCA_CERT_USE_NEWEST=true
ZATCA_ALLOW_HISTORICAL_SIGNING=false
ZATCA_CERT_OVERLAP_GRACE_DAYS=7
ZATCA_LEGAL_HOLD_ENABLED=true
ZATCA_RETENTION_INVOICES_YEARS=7
ZATCA_RETENTION_AUDIT_YEARS=7
ZATCA_RETENTION_SUBMISSIONS_YEARS=7
ZATCA_DR_RPO_MINUTES=5
ZATCA_DR_RTO_MINUTES=30
ZATCA_BACKUP_RETENTION_DAYS=30
ZATCA_ALLOW_CROSS_BORDER=false

# ZATCA Certificate Notifications
ZATCA_CERT_NOTIFICATIONS_ENABLED=true
ZATCA_CERT_NOTIFY_CHANNELS=mail,webhook

# ZATCA Evidence Export
ZATCA_EVIDENCE_EXPORT_ENABLED=true
ZATCA_EVIDENCE_CACHE_TTL=24

# ZATCA Disaster Recovery
ZATCA_RPO_HOURS=1
ZATCA_RTO_HOURS=4
ZATCA_TEST_RECOVERY_ENABLED=false
ZATCA_TEST_RECOVERY_SCHEDULE=monthly

# Platform License Configuration
# Required for production deployments
PLATFORM_LICENSE_ENABLED=true
PLATFORM_LICENSE_KEY=
PLATFORM_LICENSE_SERVER_URL=https://license.your-domain.com
PLATFORM_LICENSE_SECRET=
PLATFORM_LICENSE_GRACE_DAYS=3
PLATFORM_LICENSE_WARNING_DAYS=7
PLATFORM_LICENSE_CACHE_SECONDS=3600

# Licensing Module
LICENSE_CACHE_ENABLED=true
LICENSE_CACHE_TTL=300
LICENSE_API_KEY_PREFIX=cpay_
LICENSE_RATE_LIMIT_DRIVER=redis
LICENSE_USAGE_RETENTION_DAYS=365
LICENSE_AUDIT_ENABLED=true
LICENSE_AUDIT_RETENTION_DAYS=730
LICENSE_ADMIN_BYPASS=false
LICENSE_REQUIRE_ACTIVATION=true
