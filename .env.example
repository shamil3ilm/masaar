APP_NAME=Masaar
# Safe-by-default: a deployment seeded from this file starts in production mode
# with debug off. For local development set APP_ENV=local and APP_DEBUG=true.
# The application refuses to boot with APP_ENV=production and APP_DEBUG=true,
# because debug mode returns internal error detail through the API.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people reach this deployment at. Links in mail and two-factor
# enrolment links are built from it; production refuses to serve on localhost.
APP_URL=http://localhost

# Reverse proxies whose X-Forwarded-* headers are believed: addresses or CIDR
# ranges, comma-separated. Blank trusts none. Behind a proxy that is left
# blank, every client appears to be the proxy and they share one rate limit.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single

# Where a critical event goes. Seven places raise one - a kill switch thrown,
# ZATCA answering a submission the database then failed to record - and every
# alert channel is appended to LOG_STACK automatically, so it cannot be lost
# by forgetting it here. Alerts are always written to storage/logs/alerts.log;
# set the webhook as well and they go to Slack too. Left empty, nothing is
# sent anywhere a human will see within the reporting deadline.
LOG_SLACK_WEBHOOK_URL=
LOG_ALERT_LEVEL=critical
LOG_ALERT_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=masaar
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Blank means no AUTH, for a local Redis. Docker Compose refuses to start
# without one: it is the password the Redis container is started with.
REDIS_PASSWORD=
REDIS_PORT=6379

# Production refuses to serve with log or array: certificate expiry notices,
# email verification and password resets would never leave the server.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (config/backup.php, docs/BACKUP-AND-RESTORE.md): the database and
# the credential store, nightly, to an object store. The password encrypts
# the archive (AES-256) and is required - without it the run is refused. Keep
# it, APP_KEY and ZATCA_CREDENTIAL_KEY somewhere other than the bucket: a
# restore needs all three.
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
# The object store: any provider speaking the S3 protocol. The endpoint,
# region and keys come from the provider's console.
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_KEY=
BACKUP_STORAGE_SECRET=
BACKUP_STORAGE_PATH_STYLE=true
# Alert once the archives use this much of the bucket. Nothing is pruned to
# fit; keep it under the bucket's quota.
BACKUP_ALERT_AT_MEGABYTES=16384
# 'skip-ssl' when the dump client is MariaDB's and the server certificate is
# self-signed, as in docker-compose.yml. Empty uses the client's default.
DB_DUMP_SSL_FLAG=

VITE_APP_NAME="${APP_NAME}"

# JWT Authentication. Required in production: php artisan jwt:secret writes it.
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# HS256 signs and verifies with the same secret, so every service that reads a
# token can also mint one. Set JWT_ALGO=RS256 with a key pair to make issuing
# and verifying separate abilities.
JWT_ALGO=HS256
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
# JWT_PASSPHRASE=

# Clock skew tolerated when checking expiry, in seconds. Above zero, an expired
# token stays usable for that long.
JWT_LEEWAY=0

# Lets a token be revoked before it expires — needed for sign-out to end a
# session rather than only forget it client-side.
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# CORS Configuration
# Comma-separated list of allowed origins (leave empty to block all cross-origin requests)
CORS_ALLOWED_ORIGINS=

# Prometheus Metrics Access
# /api/metrics exposes version and business telemetry. Admit a scraper by its
# source IP or by a bearer token. With both empty the endpoint is unreachable
# in production and open outside it.
# Behind a reverse proxy, prefer the token: TrustProxies is not configured, so
# the observed source IP is the proxy's. See config/metrics.php.
METRICS_ALLOWED_IPS=
METRICS_TOKEN=

# Outbound Fetch Controls
# Hosts the server may contact when the address came from data it did not
# choose - certificate revocation endpoints are read from inside the
# certificate being validated. Comma-separated; a leading dot allows that
# zone's subdomains. Leave empty and the fallback applies: https only, and
# the host must not resolve to a private, loopback or link-local address.
REVOCATION_ALLOWED_HOSTS=
# Hosts a tenant's webhook may point at, in the same form. Usually empty:
# then https only, resolving only to public addresses.
WEBHOOK_ALLOWED_HOSTS=
OUTBOUND_FETCH_TIMEOUT=10
OUTBOUND_FETCH_MAX_BYTES=5242880

# API Key Hashing
# Mixed into API key hashes so a leaked api_keys table cannot be attacked
# offline. Setting or changing this invalidates every key issued before it,
# so production requires it from the start: openssl rand -base64 32
API_KEY_PEPPER=

# Rate Limits (per tenant, per minute, per cost band)
# Requests a minute, per tenant, per cost band. Ordered by what a request
# costs: a band below RATE_LIMIT_DEFAULT penalises its own traffic, since
# anything outside a band falls through to the default.
#
# Change these as a set. Raising RATE_LIMIT_SUBMISSION alone leaves
# submissions throttled more loosely than ordinary reads, which is the
# ordering RateLimitConfigTest refuses.
#
# RATE_LIMIT_SUBMISSION must equal ZATCA_RATE_LIMIT_PER_MINUTE below - the two
# throttle the same traffic, one at the edge and one in SubmissionGuard, and
# the lower silently decides. AppServiceProvider will not boot production
# while they disagree.
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_SUBMISSION=120
RATE_LIMIT_ONBOARDING=5
RATE_LIMIT_READ=600
RATE_LIMIT_ANONYMOUS=20

# Signing Credential Storage
# Where each taxpayer's CSID credentials are kept. The default is the
# container's own filesystem, which confines the platform to one replica:
# a tenant onboarded on one instance cannot sign on another. Point this at a
# shared, private disk before scaling out.
ZATCA_CREDENTIAL_DISK=local

# The secret those credentials are encrypted under. Empty falls back to
# APP_KEY, which also protects sessions and cookies and sits in every
# container - a wide blast radius for signing keys. Set this, keep the old
# value in PREVIOUS_KEYS, run masaar:rotate-credential-key, then clear it.
# Leave this EMPTY here. A real key was committed to this file on 2026-10-10
# and pushed to a public repository, which is why the warning exists: this file
# is tracked and published, .env is not. Generate the key into .env.
ZATCA_CREDENTIAL_KEY=
ZATCA_CREDENTIAL_PREVIOUS_KEYS=

# ZATCA E-Invoicing Configuration
ZATCA_ENVIRONMENT=production

# ZATCA's gateway and portal addresses. Leave empty to use ZATCA's published
# ones; set them only if the authority moves an endpoint.
ZATCA_SANDBOX_URL=
ZATCA_SIMULATION_URL=
ZATCA_PRODUCTION_URL=
ZATCA_PORTAL_URL=
# Full path to the OpenSSL binary the onboarding commands run. Empty: the one
# on the PATH.
OPENSSL_BIN=
# No ZATCA_USERNAME or ZATCA_PASSWORD: each device files with the token and
# secret it was issued at onboarding, kept in the credential store.
ZATCA_CERT_WARNING_DAYS=30
ZATCA_CERT_CRITICAL_DAYS=7
ZATCA_TIMEOUT=30
ZATCA_CONNECT_TIMEOUT=10
ZATCA_RETRY_ATTEMPTS=3
ZATCA_RETRY_DELAY=1000
ZATCA_SSL_VERIFY=true

# ZATCA Rate Limits
# Keep in step with RATE_LIMIT_SUBMISSION above.
ZATCA_RATE_LIMIT_PER_MINUTE=120

# ZATCA gives a simplified (B2C) invoice this many hours from issuance to be
# reported. It is a legal figure, not a tuning knob - lower it only to test.
# The hourly overdue sweep and the admin deadline screen read it to say what
# is late. Nothing refuses a late report: it is still owed.
ZATCA_REPORTING_DEADLINE_HOURS=24
ZATCA_RATE_LIMIT_PER_DAY=10000
ZATCA_MAX_CONCURRENT=10
# Minutes a submission may sit in flight before it is treated as lost and
# recovered by fatoora:recover-submissions.
ZATCA_STALE_SUBMISSION_MINUTES=15

# ZATCA Offline Mode
ZATCA_OFFLINE_QUEUE_MAX=10000
ZATCA_OFFLINE_RETRY_INTERVAL=300
ZATCA_OFFLINE_MAX_ATTEMPTS=3
ZATCA_AUTO_RECOVERY_ENABLED=true

# ZATCA Timestamp Authority (optional, for XAdES-T)
ZATCA_TSA_ENABLED=false
# ZATCA_TSA_URL=
# ZATCA_TSA_USERNAME=
# ZATCA_TSA_PASSWORD=
ZATCA_TSA_TIMEOUT=30

# ZATCA Feature Flags
ZATCA_FEATURE_OFFLINE=true
ZATCA_FEATURE_CIRCUIT_BREAKER=true
ZATCA_FEATURE_CRL_CHECK=true
ZATCA_FEATURE_ARABIC_NORM=true

# ZATCA Queue
# Empty means the application's own QUEUE_CONNECTION. Set it only to put ZATCA
# work on a separate connection, and make sure a worker runs there — this said
# redis while QUEUE_CONNECTION is database, and nothing read it, so the setting
# described a topology the platform was not using.
ZATCA_QUEUE_CONNECTION=
# Workers must be started on these names, or submissions and webhook deliveries
# queue for ever with nothing to process them:
#   php artisan queue:work --queue=zatca-submissions,webhooks,default
ZATCA_QUEUE_NAME=zatca-submissions
ZATCA_QUEUE_WEBHOOKS=webhooks
ZATCA_QUEUE_TRIES=3
ZATCA_QUEUE_TIMEOUT=120

# ZATCA Idempotency
ZATCA_IDEMPOTENCY_HOURS=24

# ZATCA Thresholds
ZATCA_LARGE_INVOICE_THRESHOLD=1000000

# ZATCA Circuit Breaker
ZATCA_CCB_FAILURE_THRESHOLD=5
ZATCA_CCB_SUCCESS_THRESHOLD=3
ZATCA_CCB_TIMEOUT=60
ZATCA_CCB_HALF_OPEN_REQUESTS=3

# ZATCA Kill Switch
ZATCA_KS_MAX_DURATION=14400
ZATCA_KS_ALERT_THRESHOLD=1800
ZATCA_KS_CACHE_TTL=3600

# ZATCA Hash Chain
ZATCA_HASH_CHAIN_MONITORING=true
ZATCA_HASH_CHAIN_P95_WARNING=50
ZATCA_HASH_CHAIN_P99_CRITICAL=200
ZATCA_HASH_CHAIN_SAMPLE_INTERVAL=5
ZATCA_HASH_CHAIN_ALERT=true

# ZATCA Strict Exemption Codes
ZATCA_STRICT_EXEMPTION_CODES=false

# ZATCA Certificate Notifications

# Platform License Configuration
# Gates the whole API: PlatformLicense runs on every /api route and answers 403
# when the key is missing, expired or unrecognised.
#
# Off by default because a fresh checkout has no key, and enabled with an empty
# PLATFORM_LICENSE_KEY means "enforce, with nothing to enforce against" — every
# request refused. That combination shipped as the default and was harmless only
# because the middleware was attached to no route. Production sets this true and
# supplies a key.
PLATFORM_LICENSE_ENABLED=false
PLATFORM_LICENSE_KEY=
PLATFORM_LICENSE_SERVER_URL=https://license.your-domain.com
PLATFORM_LICENSE_SECRET=
PLATFORM_LICENSE_WARNING_DAYS=7
PLATFORM_LICENSE_CACHE_SECONDS=3600

# Licensing Module
# An organization needs an active licence - its plan, assigned when a platform
# admin approves it - before it can connect to ZATCA and issue.
LICENSING_FILING_REQUIRES_LICENCE=true
LICENSE_CACHE_TTL=300
LICENSE_AUDIT_ENABLED=true

# UAE FTA E-Invoicing
# The second jurisdiction this platform serves. Every one of these settings was
# read from the environment and named nowhere, so an operator deploying UAE
# compliance had nothing to set: submissions went to the sandbox with no
# credential and failed at the authority rather than at startup.
#
# Off: this deployment files with ZATCA only. While off, the UAE routes answer
# 404 and the settings below are not read. Leave the environment on sandbox
# until the credentials below are real.
UAE_FTA_ENABLED=false
UAE_FTA_ENVIRONMENT=production
UAE_FTA_SANDBOX_URL=https://sandbox-einvoicing.tax.gov.ae/api/v1
UAE_FTA_PRODUCTION_URL=https://einvoicing.tax.gov.ae/api/v1

# Issued by the FTA, and the only credential the submission path uses. Empty
# here on purpose — a secret in a committed file is a leaked secret.
UAE_FTA_API_KEY=

UAE_FTA_TIMEOUT=30

# ZATCA's SDK, unpacked: the directory holding Apps/ and Data/. It is a
# licensed download from the Fatoora portal and cannot be committed, so
# everything that needs it is optional on it.
#
# Setting this one variable does three things: CSR generation uses the SDK
# instead of falling back to phpseclib, generated XML is validated against the
# UBL 2.1 schema inside it rather than only checked for well-formedness, and
# the conformance suite runs ZATCA's own validator over documents this platform
# produced. Leave it unset and all three degrade quietly - the tests skip
# rather than fail, which is honest but proves nothing.
# ZATCA_SDK_PATH=/path/to/zatca-einvoicing-sdk-Java-238-R3.4.8

# Overrides the schema location for a copy kept outside the SDK. Point it at
# the main document and keep the tree around it; the file imports the common
# components beside it.
# ZATCA_SCHEMA_PATH=/path/to/UBL2.1/xsd/maindoc/UBL-Invoice-2.1.xsd

# Sign-up
# Businesses register themselves at /register, verify their email address,
# and wait for a platform admin to approve them before they can connect to
# ZATCA or issue. Off: the platform creates every organization itself.
SIGNUP_ENABLED=true
# The terms a business accepts, and their version - stored with each
# acceptance, so a change of terms is a new version.
# Empty: the /terms page this deployment publishes.
SIGNUP_TERMS_URL=
SIGNUP_TERMS_VERSION=1

# Support tickets
# Where a new ticket is announced by email. Empty: the admin console's
# Support queue is the only place tickets show.
SUPPORT_NOTIFY_ADDRESS=
# Megabytes of ticket attachments one company may add in a day.
SUPPORT_DAILY_UPLOAD_MB=50

# Billing
# The organization the platform's own invoices are issued from - the
# operator's company, approved and connected to ZATCA like any other. Empty:
# recorded payments renew plans and no invoice is issued for them.
BILLING_ORGANIZATION_ID=
# Monthly price of each plan, excluding VAT, in SAR.
BILLING_PRICE_STARTER=500
BILLING_PRICE_PROFESSIONAL=2000
BILLING_PRICE_ENTERPRISE=5000
BILLING_PRICE_UNLIMITED=0

# Who operates this deployment, as the public pages, the privacy notice and
# the terms name them. Fill these before the first customer signs up.
COMPANY_LEGAL_NAME=
COMPANY_CR_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
# Raise when the privacy notice changes.
PRIVACY_VERSION=1
