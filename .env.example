APP_NAME=Masaar
# The product's name and what is made from it (config/brand.php). APP_NAME is
# the English name; each BRAND_ setting below falls back to one made from it.
# BRAND_NAME_AR=
# BRAND_SLUG=
# BRAND_LEGAL_NAME=
# BRAND_SUPPORT_EMAIL=
# BRAND_DOMAIN=
# BRAND_USER_AGENT=
# BRAND_METRICS_PREFIX=
# BRAND_CSR_SOLUTION=
# Safe-by-default: a deployment seeded from this file starts in production mode
# with debug off. For local development set APP_ENV=local and APP_DEBUG=true.
# The application refuses to boot with APP_ENV=production and APP_DEBUG=true,
# because debug mode returns internal error detail through the API.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people reach this deployment at. Links in mail and two-factor
# enrolment links are built from it; production refuses to serve on localhost.
APP_URL=http://localhost

# Reverse proxies whose X-Forwarded-* headers are believed: addresses or CIDR
# ranges, comma-separated. Blank trusts none. Behind a proxy that is left
# blank, every client appears to be the proxy and they share one rate limit.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single

# Where a critical event goes. Seven places raise one - a kill switch thrown,
# ZATCA answering a submission the database then failed to record - and every
# alert channel is appended to LOG_STACK automatically, so it cannot be lost
# by forgetting it here. Alerts are always written to storage/logs/alerts.log;
# set the webhook as well and they go to Slack too. Left empty, nothing is
# sent anywhere a human will see within the reporting deadline.
LOG_SLACK_WEBHOOK_URL=
LOG_ALERT_LEVEL=critical
LOG_ALERT_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=platform
DB_USERNAME=root
DB_PASSWORD=
# Migrations create the immutability triggers. With binary logging on, the
# MySQL server needs log_bin_trust_function_creators=1 and the migrating user
# the TRIGGER privilege. To keep TRIGGER, ALTER and DROP from the application
# user, give the migrate step its own account (docs/operations/DEPLOYMENT.md).
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# Blank means no AUTH, for a local Redis. Docker Compose refuses to start
# without one: it is the password the Redis container is started with.
REDIS_PASSWORD=
REDIS_PORT=6379

# Production refuses to serve with log or array: certificate expiry notices,
# email verification and password resets would never leave the server.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (config/backup.php, docs/operations/BACKUP-AND-RESTORE.md): the database and
# the credential store, nightly, to an object store. The password encrypts
# the archive (AES-256) and is required - without it the run is refused. Keep
# it, APP_KEY and ZATCA_CREDENTIAL_KEY somewhere other than the bucket: a
# restore needs all three.
BACKUP_DISKS=backups
BACKUP_ARCHIVE_PASSWORD=
# The object store: any provider speaking the S3 protocol. The endpoint,
# region and keys come from the provider's console.
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_BUCKET=
BACKUP_STORAGE_KEY=
BACKUP_STORAGE_SECRET=
BACKUP_STORAGE_PATH_STYLE=true
# Alert once the archives use this much of the bucket. Nothing is pruned to
# fit; keep it under the bucket's quota.
BACKUP_ALERT_AT_MEGABYTES=16384
# How many years a yearly archive is kept: the longest record-keeping period
# that applies - fifteen for real estate records in Saudi Arabia.
BACKUP_YEARLY_RETENTION_YEARS=15
# 'skip-ssl' when the dump client is MariaDB's and the server certificate is
# self-signed, as in docker-compose.yml. Empty uses the client's default.
DB_DUMP_SSL_FLAG=

VITE_APP_NAME="${APP_NAME}"

# JWT Authentication. Required in production: php artisan jwt:secret writes it.
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# HS256 signs and verifies with the same secret, so every service that reads a
# token can also mint one. Set JWT_ALGO=RS256 with a key pair to make issuing
# and verifying separate abilities.
JWT_ALGO=HS256
# JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY=
# JWT_PASSPHRASE=

# Clock skew tolerated when checking expiry, in seconds. Above zero, an expired
# token stays usable for that long.
JWT_LEEWAY=0

# Lets a token be revoked before it expires — needed for sign-out to end a
# session rather than only forget it client-side.
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# CORS Configuration
# Comma-separated list of allowed origins (leave empty to block all cross-origin requests)
CORS_ALLOWED_ORIGINS=

# Prometheus Metrics Access
# /api/metrics exposes version and business telemetry. Admit a scraper by its
# source IP or by a bearer token. With both empty the endpoint is unreachable
# in production and open outside it.
# Behind a reverse proxy, prefer the token: TrustProxies is not configured, so
# the observed source IP is the proxy's. See config/metrics.php.
METRICS_ALLOWED_IPS=
METRICS_TOKEN=

# Outbound Fetch Controls
# Hosts the server may contact when the address came from data it did not
# choose - certificate revocation endpoints are read from inside the
# certificate being validated. Comma-separated; a leading dot allows that
# zone's subdomains. Leave empty and the fallback applies: https only, and
# the host must not resolve to a private, loopback or link-local address.
REVOCATION_ALLOWED_HOSTS=
# Hosts a tenant's webhook may point at, in the same form. Usually empty:
# then https only, resolving only to public addresses.
WEBHOOK_ALLOWED_HOSTS=
OUTBOUND_FETCH_TIMEOUT=10
OUTBOUND_FETCH_MAX_BYTES=5242880
# Seconds the breached-password service has to connect and again to answer;
# past that a new password is judged on the other rules and a warning logged.
PASSWORD_BREACH_CHECK_TIMEOUT=3

# API Key Hashing
# Mixed into API key hashes so a leaked api_keys table cannot be attacked
# offline. Setting or changing this invalidates every key issued before it,
# so production requires it from the start: openssl rand -base64 32
API_KEY_PEPPER=

# Rate Limits (per tenant, per minute, per cost band)
# Requests a minute, per tenant, per cost band. Ordered by what a request
# costs: a band below RATE_LIMIT_DEFAULT penalises its own traffic, since
# anything outside a band falls through to the default.
#
# Change these as a set. Raising RATE_LIMIT_SUBMISSION alone leaves
# submissions throttled more loosely than ordinary reads, which is the
# ordering RateLimitConfigTest refuses.
#
# RATE_LIMIT_SUBMISSION must equal ZATCA_RATE_LIMIT_PER_MINUTE below - the two
# throttle the same traffic, one at the edge and one in SubmissionGuard, and
# the lower silently decides. AppServiceProvider will not boot production
# while they disagree.
RATE_LIMIT_DEFAULT=300
RATE_LIMIT_SUBMISSION=300
RATE_LIMIT_ONBOARDING=5
RATE_LIMIT_READ=600
RATE_LIMIT_ANONYMOUS=20

# Invoices one POST /api/v1/pipeline/batch may carry. Each is issued and filed
# within the request, so this bounds its duration as well as its size.
PIPELINE_BATCH_MAX_ITEMS=50

# Signing Credential Storage
# Where each taxpayer's CSID credentials are kept. The default is the local
# disk (storage/app/private), which in the compose stack is the
# platform-storage volume every replica on the host shares. Point this at a
# shared, private disk before running replicas on more than one host.
ZATCA_CREDENTIAL_DISK=local

# The secret those credentials are encrypted under. Required in production:
# the platform refuses to serve without it. Empty falls back to APP_KEY
# (development only), which also protects sessions and cookies and sits in
# every container - a wide blast radius for signing keys. Moving from APP_KEY:
# set this, put the old key (APP_KEY) in PREVIOUS_KEYS, run
# platform:rotate-credential-key, then clear PREVIOUS_KEYS.
# Leave this EMPTY here. A real key was once committed to this file and pushed
# to a public repository, which is why the warning exists: this file is
# tracked and published, .env is not. Generate the key into .env.
ZATCA_CREDENTIAL_KEY=
ZATCA_CREDENTIAL_PREVIOUS_KEYS=

# Seals each new audit log entry and each chain's head with a keyed hash, so
# someone with the database but not this key cannot rewrite the audit log
# unseen. Its own key: APP_KEY is refused. Keep it out of the database and its
# backups. Rotating: move the old key to PREVIOUS_KEYS (comma separated),
# which still verify. Leave EMPTY here; generate into .env:
# openssl rand -base64 32 (prefix base64:). platform:simulation-preflight
# fails without it.
AUDIT_CHAIN_KEY=
AUDIT_CHAIN_PREVIOUS_KEYS=

# ZATCA E-Invoicing Configuration
# The default for organizations with no ZATCA environment of their own; a
# platform admin sets each organization's in the console. sandbox, simulation
# or production; production refuses sandbox, which files only for ZATCA's test
# VAT number (platform:rehearse uses it).
ZATCA_ENVIRONMENT=production

# Whether this deployment issues in Saudi Arabia, until a platform admin
# switches it on the console's Countries page (/admin/countries), which then
# wins. Off: nothing new is issued in Saudi Arabia and sign-up does not offer
# it; invoices already issued keep being filed (offline queue, recovery).
ZATCA_ENABLED=true

# ZATCA's gateway and portal addresses. Leave empty to use ZATCA's published
# ones; set them only if the authority moves an endpoint.
ZATCA_SANDBOX_URL=
ZATCA_SIMULATION_URL=
ZATCA_PRODUCTION_URL=
ZATCA_PORTAL_URL=
# Full path to the OpenSSL binary the onboarding commands run. Empty: the one
# on the PATH.
OPENSSL_BIN=
# No ZATCA_USERNAME or ZATCA_PASSWORD: each device files with the token and
# secret it was issued at onboarding, kept in the credential store.
ZATCA_CERT_WARNING_DAYS=30
ZATCA_CERT_CRITICAL_DAYS=7
# PEM bundle of ZATCA's CA certificates (issuing CA up to the root), for the
# chain in stamped PDFs and to verify revocation lists served over http.
# Required in production while Saudi Arabia is on: /api/health/ready fails
# without a readable file.
ZATCA_CA_CHAIN_PATH=
# The CA's revocation list URLs (comma-separated), for certificates that name
# no CRL distribution point. Checked before every stamp. In production,
# /api/health/ready fails while an active certificate names none and this is
# empty.
ZATCA_CRL_URLS=
ZATCA_TIMEOUT=30
ZATCA_CONNECT_TIMEOUT=10
ZATCA_RETRY_ATTEMPTS=3
ZATCA_RETRY_DELAY=1000
ZATCA_SSL_VERIFY=true

# ZATCA Rate Limits
# The organization's ceiling across its devices. Keep the minute in step with
# RATE_LIMIT_SUBMISSION above.
ZATCA_RATE_LIMIT_PER_MINUTE=300
# Each device (a branch with its own certificate, or head office) within it.
ZATCA_DEVICE_RATE_LIMIT_PER_MINUTE=120
ZATCA_DEVICE_RATE_LIMIT_PER_DAY=10000

# ZATCA gives a simplified (B2C) invoice this many hours from issuance to be
# reported. It is a legal figure, not a tuning knob - lower it only to test.
# The hourly overdue sweep and the admin deadline screen read it to say what
# is late. Nothing refuses a late report: it is still owed.
ZATCA_REPORTING_DEADLINE_HOURS=24
# A till's own sale time (sold_at) is the supply, never the moment of issue,
# and a late sale is never refused. One further ahead of the platform's
# clock than this many seconds is.
ZATCA_SALE_TIME_MAX_AHEAD_SECONDS=30
ZATCA_RATE_LIMIT_PER_DAY=100000
ZATCA_MAX_CONCURRENT=10
# Minutes a submission may sit in flight before it is treated as lost and
# recovered by fatoora:recover-submissions.
ZATCA_STALE_SUBMISSION_MINUTES=15

# ZATCA Offline Mode
ZATCA_OFFLINE_QUEUE_MAX=10000
ZATCA_OFFLINE_RETRY_INTERVAL=900
ZATCA_OFFLINE_MAX_ATTEMPTS=3
ZATCA_AUTO_RECOVERY_ENABLED=true
# Each five-minute drain: a slice from each organization in turn, up to a
# share per organization, within a time budget under the five minutes.
ZATCA_OFFLINE_DRAIN_PER_ORGANIZATION=1000
ZATCA_OFFLINE_DRAIN_SLICE=25
ZATCA_OFFLINE_DRAIN_MAX_SECONDS=240

# ZATCA Feature Flags
ZATCA_FEATURE_OFFLINE=true
ZATCA_FEATURE_CIRCUIT_BREAKER=true
ZATCA_FEATURE_CRL_CHECK=true
ZATCA_FEATURE_ARABIC_NORM=true

# ZATCA Queue
# Empty means the application's own QUEUE_CONNECTION. Set it only to put ZATCA
# work on a separate connection, and make sure a worker runs there — this said
# redis while QUEUE_CONNECTION is database, and nothing read it, so the setting
# described a topology the platform was not using.
ZATCA_QUEUE_CONNECTION=
# Workers must be started on these names, or submissions and webhook deliveries
# queue for ever with nothing to process them:
#   php artisan queue:work --queue=zatca-submissions,webhooks,default
ZATCA_QUEUE_NAME=zatca-submissions
ZATCA_QUEUE_WEBHOOKS=webhooks
ZATCA_QUEUE_TRIES=3
ZATCA_QUEUE_TIMEOUT=120

# ZATCA Idempotency
ZATCA_IDEMPOTENCY_HOURS=24

# ZATCA Thresholds
ZATCA_LARGE_INVOICE_THRESHOLD=1000000

# ZATCA Circuit Breaker
ZATCA_CCB_FAILURE_THRESHOLD=5
ZATCA_CCB_SUCCESS_THRESHOLD=3
ZATCA_CCB_TIMEOUT=60
ZATCA_CCB_HALF_OPEN_REQUESTS=3

# ZATCA Kill Switch
ZATCA_KS_MAX_DURATION=14400
ZATCA_KS_ALERT_THRESHOLD=1800
ZATCA_KS_CACHE_TTL=3600

# ZATCA Hash Chain
ZATCA_HASH_CHAIN_MONITORING=true
ZATCA_HASH_CHAIN_P95_WARNING=50
ZATCA_HASH_CHAIN_P99_CRITICAL=200
ZATCA_HASH_CHAIN_SAMPLE_INTERVAL=5
ZATCA_HASH_CHAIN_ALERT=true

# ZATCA Certificate Notifications

# Platform License Configuration
# Gates the whole API: PlatformLicense runs on every /api route and answers 403
# when the key is missing, expired or unrecognised.
#
# Off here because a fresh checkout has no key, and enabled with an empty
# PLATFORM_LICENSE_KEY means "enforce, with nothing to enforce against" — every
# request refused. A partner's installation sets this true with the key and
# secret it was issued (production then refuses to boot without the secret); a
# deployment its operator runs itself leaves it false. The config default, with
# no value at all, is true. See docs/operations/LICENSING.md.
PLATFORM_LICENSE_ENABLED=false
PLATFORM_LICENSE_KEY=
PLATFORM_LICENSE_SERVER_URL=https://license.your-domain.com
PLATFORM_LICENSE_SECRET=
PLATFORM_LICENSE_WARNING_DAYS=7
PLATFORM_LICENSE_CACHE_SECONDS=3600

# Licensing Module
# An organization needs an active licence - its plan, assigned when a platform
# admin approves it - before it can connect to ZATCA and issue.
LICENSING_FILING_REQUIRES_LICENCE=true
# A customer's allowances unless a platform admin sets its own: invoices a
# month and API calls a day per licence. -1 is unlimited, the default.
LICENSING_MONTHLY_INVOICES=-1
LICENSING_DAILY_API_CALLS=-1
LICENSE_CACHE_TTL=300
LICENSE_AUDIT_ENABLED=true

# Peppol e-invoicing (UAE, PINT AE)
# Sent and received through an accredited service provider (ASP), which
# carries each document over the Peppol network and reports it to the
# authority.
#
# Whether this deployment issues in the UAE, until a platform admin switches
# it on the console's Countries page (/admin/countries), which then wins - the
# same switch as ZATCA_ENABLED. Off: nothing new is issued in the UAE and an
# organization cannot be registered there; documents already issued keep
# being sent and polled.
PEPPOL_AE_ENABLED=false
# The last date a UAE organization may appoint its e-invoicing service
# provider (YYYY-MM-DD), which its revenue band sets (UAE Electronic
# Invoicing Guidelines v1.1, p19). Organizations with no provider appointed
# are reminded before it; empty sends no reminders. An organization can
# record its own date on its company page.
# PEPPOL_AE_APPOINTMENT_DEADLINE=

# The ASP's API. Empty base URL: no provider is connected, and documents wait
# to be downloaded and uploaded by hand. Once it is set, production refuses to
# serve until the client id, client secret and webhook secret are set too.
# Secrets empty here on purpose - a secret in a committed file is a leaked one.
PEPPOL_ASP_BASE_URL=
PEPPOL_ASP_CLIENT_ID=
PEPPOL_ASP_CLIENT_SECRET=
# Verifies the signature on the ASP's status and inbound callbacks.
PEPPOL_ASP_WEBHOOK_SECRET=
# The queue documents are sent from. The container runs a worker on it
# (laravel-worker-peppol); elsewhere, run one: queue:work --queue=peppol
PEPPOL_QUEUE=peppol
# Hours a document is tried without an answer from the ASP before it is
# failed. The clock stops while the ASP is in an outage (no answer to several
# documents in a row), and waiting documents are sent when it is back.
# PEPPOL_RETRY_WINDOW_HOURS=72

# Local and staging only: a service-provider simulator in place of the ASP,
# so the whole UAE flow runs with no provider (docs/ae/SIMULATOR.md). It
# checks every document against the PINT AE rules (the two variables below),
# then calls back through the signed webhooks at the callback URL (APP_URL
# when empty), STEP_SECONDS apart, from the Peppol queue's worker.
# Production refuses to boot with it.
# PEPPOL_GATEWAY=simulator
# PEPPOL_SIMULATOR_STEP_SECONDS=10
# PEPPOL_SIMULATOR_CALLBACK_URL=

# Tests and the simulator: the official PINT AE validation artefacts
# (unpacked) and an XSLT 2 processor jar to run them. The conformance tests
# skip without both, and the simulator sends nothing.
# PEPPOL_ARTEFACTS_PATH=
# PEPPOL_XSLT_JAR=

# ZATCA's SDK, unpacked: the directory holding Apps/ and Data/. It is a
# licensed download from the Fatoora portal and cannot be committed, so
# everything that needs it is optional on it.
#
# Setting this one variable does three things: CSR generation uses the SDK
# instead of falling back to phpseclib, generated XML is validated against the
# UBL 2.1 schema inside it rather than only checked for well-formedness, and
# the conformance suite runs ZATCA's own validator over documents this platform
# produced. Leave it unset and all three degrade quietly - the tests skip
# rather than fail, which is honest but proves nothing.
# ZATCA_SDK_PATH=/path/to/zatca-einvoicing-sdk-Java-238-R3.4.8

# A PDF/A validator's command-line launcher. Tests only: when set, the PDF/A
# suite checks that invoice PDFs are PDF/A-3b, stamped and unstamped.
# PDFA_VALIDATOR_PATH=/path/to/pdfa-validator

# Overrides the schema location for a copy kept outside the SDK. Point it at
# the main document and keep the tree around it; the file imports the common
# components beside it.
# ZATCA_SCHEMA_PATH=/path/to/UBL2.1/xsd/maindoc/UBL-Invoice-2.1.xsd

# Sign-up
# Businesses register themselves at /register, verify their email address,
# and wait for a platform admin to approve them before they can connect to
# ZATCA or issue. Off: the platform creates every organization itself.
SIGNUP_ENABLED=true
# The terms a business accepts, and their version - stored with each
# acceptance, so a change of terms is a new version.
# Empty: the /terms page this deployment publishes.
SIGNUP_TERMS_URL=
SIGNUP_TERMS_VERSION=1

# Support tickets
# Where a new ticket is announced by email. Empty: the admin console's
# Support queue is the only place tickets show.
SUPPORT_NOTIFY_ADDRESS=
# Megabytes of ticket attachments one company may add in a day.
SUPPORT_DAILY_UPLOAD_MB=50

# Billing
# The organization the platform's own invoices are issued from - the
# operator's company, approved and connected to ZATCA like any other. Empty:
# recorded payments renew plans and no invoice is issued for them. Its Arabic
# name (the seller's name on every invoice) is set on its company page; the
# console's billing and Countries pages say when it is missing.
BILLING_ORGANIZATION_ID=
# The card gateway: empty until a card provider is contracted (card payments
# are not offered), or simulator - a provider played inside the application
# for local and staging. Production refuses to boot with the simulator.
PAYMENT_GATEWAY=
# The share of each card payment the simulator keeps as its fee.
# PAYMENT_SIMULATOR_FEE_PERCENT=2.5

# Who operates this deployment, as the public pages, the privacy notice and
# the terms name them. Fill these before the first customer signs up.
COMPANY_LEGAL_NAME=
COMPANY_CR_NUMBER=
COMPANY_VAT_NUMBER=
COMPANY_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
# Raise when the privacy notice changes.
PRIVACY_VERSION=1
