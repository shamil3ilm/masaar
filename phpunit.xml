<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- As production and CI run: a developer .env with debug on once hid a
             broken error page that only failed with debug off. -->
        <env name="APP_DEBUG" value="false" force="true"/>
        <!-- Never production in a test, whatever .env holds: .env.example ships
             production, CI copies it, and sandbox credentials were refused as
             live. A test that needs another gateway sets config itself. -->
        <env name="ZATCA_ENVIRONMENT" value="sandbox" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="JWT_SECRET" value="test-secret-key-for-testing-only-at-least-32-chars"/>
        <!--
            The platform licence gate runs on every API route and defaults to
            enforcing, so without a key the suite would answer 403 to everything.
            Off here; PlatformLicenseTest turns it on where that is the subject.
        -->
        <env name="PLATFORM_LICENSE_ENABLED" value="false"/>
        <!-- On for the suite, so the UAE code stays tested while a deployment keeps it off. -->
        <env name="PEPPOL_AE_ENABLED" value="true"/>
        <!-- Off for the suite: its fixtures issue for organizations without a
             licence. LicenceGateTest turns it on. -->
        <env name="LICENSING_FILING_REQUIRES_LICENCE" value="false"/>
        <!--
            ZATCA work now honours its configured queue connection instead of
            ignoring it, so an operator's own .env would otherwise decide where
            the suite dispatches. Empty means the connection declared above.
        -->
        <env name="ZATCA_QUEUE_CONNECTION" value=""/>
    </php>
</phpunit>
