*.log
.DS_Store
# Editor and tooling backups. The .env rule below covers .env.bak; this covers
# the same suffix on any other file, which is otherwise untracked and picked up
# by `git add -A`.
*.bak
# Every .env variant except the committed template. Listing suffixes one at a
# time missed .env.bak, which an editor produced and git would have offered to
# commit along with a live APP_KEY and database password.
.env
.env.*
!.env.example
# pnpm's lockfile. This project installs with npm: Dockerfile runs `npm ci`
# against package-lock.json. A second lockfile leaves CI two files to believe.
pnpm-lock.yaml
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Claude Code settings contain machine-specific paths
.claude/settings.json
.claude/settings.local.json

# Python bytecode, e.g. from importing sdks/python locally
__pycache__/

# SDK build output, from compiling the SDKs locally or in CI. The SDKs are
# libraries, so their lock files are not committed either.
sdks/rust/target/
sdks/rust/Cargo.lock
sdks/typescript/node_modules/
sdks/typescript/dist/
sdks/typescript/package-lock.json
sdks/dart/.dart_tool/
sdks/dart/pubspec.lock
sdks/kotlin/build/
sdks/kotlin/.gradle/
sdks/swift/.build/
sdks/java/target/
sdks/dotnet/Masaar/bin/
sdks/dotnet/Masaar/obj/
sdks/ruby/*.gem
