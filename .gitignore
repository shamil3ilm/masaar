*.log
.DS_Store
# Editor and tooling backups. The .env rule below covers .env.bak; this covers
# the same suffix on any other file, which is otherwise untracked and picked up
# by `git add -A`.
*.bak
# Every .env variant except the committed template. Listing suffixes one at a
# time missed .env.bak, which an editor produced and git would have offered to
# commit along with a live APP_KEY and database password.
.env
.env.*
!.env.example
# pnpm's lockfile. This project installs with npm: Dockerfile runs `npm ci`
# against package-lock.json. A second lockfile leaves CI two files to believe.
pnpm-lock.yaml
